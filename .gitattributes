# Default — auto-detect, normalize on commit to LF
* text=auto eol=lf

# Force LF on shell scripts (must stay LF for Mac/Linux execution)
*.sh text eol=lf
*.bash text eol=lf

# Force CRLF on Windows-only scripts (PowerShell tolerates both)
*.ps1 text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
