# Corpify environment template
# Copy to .env after installation, fill in YOUR values.
# Never commit .env to version control.

# Required — your Anthropic API key (get at console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional — Claude model override (defaults to claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional — if you set up email integration for support
# Get app password at your email provider's security settings
# EMAIL_HOST=
# EMAIL_PORT=993
# EMAIL_USER=
# EMAIL_PASS=

# Optional — if you set up Telegram notifications
# Create bot at @BotFather
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
